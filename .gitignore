# opened files, and UI breakpoints.
xcuserdata/
*.xcuserdatad
*.xcscmblueprint
*.xccheckout

# --- Xcode Build and Cache Products ---
# This ignores your actual built applications and simulator files.
DerivedData/
build/
*.Sublime-workspace

# --- Swift Package Manager ---
.build/

# --- Backup/Temporary files ---
*.swp
*.bak
~*
