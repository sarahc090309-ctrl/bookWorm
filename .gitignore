# ==========================================
# macOS System Files
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes

# ==========================================
# Xcode Build & Cache Directories
# ==========================================
build/
DerivedData/
*.moved-aside
*.hmap

# ==========================================
# Xcode User Specific Settings
# ==========================================
# Keeps your personal window layouts and open tabs out of the shared repo
xcuserdata/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3

# ==========================================
# App Packaging & Diagnostics
# ==========================================
*.ipa
*.dSYM
*.dSYM.zip

# ==========================================
# Swift Package Manager (SPM)
# ==========================================
.build/
.swiftpm/

# NOTE: Un-comment the line below ONLY if you want to prevent committing
# Package.resolved (useful for libraries, but usually committed for apps).
# Package.resolved

# ==========================================
# Dependancy Managers (Optional)
# ==========================================
# CocoaPods
Pods/

# Carthage
Carthage/Build/
Carthage/Checkouts/

# ==========================================
# CI/CD & Automation (Fastlane)
# ==========================================
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# ==========================================
# Local Configuration / Secrets
# ==========================================
# If you store API keys locally in an xcconfig or specific file
*.xcconfig
Secrets.swift
